# Copy to backend/.env.

# Riot API key from https://developer.riotgames.com (regenerates every 24h).
X_RIOT_TOKEN=

# Seq ingestion URL. Must include the scheme. Start Seq with scripts/seq.sh.
# Leave unset to skip Seq entirely and log only to the console.
SEQ_URL=http://localhost:5341

# Only needed if the Seq instance requires an API key for ingestion.
SEQ_API_KEY=

# Optional. Defaults to 3080.
PORT=

# Optional. Defaults to "debug", or "info" when NODE_ENV=production.
LOG_LEVEL=
