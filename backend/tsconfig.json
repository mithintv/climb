// Type checking for the whole of src, tests included; tsconfig.build.json
// narrows this to what actually gets emitted.
//
// The backend is ESM ("type": "module") because pino-seq ships an import-only
// export map that CommonJS cannot require at all. rewriteRelativeImportExtensions
// is what lets imports keep the repo's "./thing.ts" style and still emit "./thing.js".
//
// experimentalDecorators + emitDecoratorMetadata are what Nest's DI reads to
// resolve constructor parameters; without the metadata every provider has to be
// annotated with an explicit @Inject token.
{
	"compilerOptions": {
		"target": "es2023",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["es2023"],
		"outDir": "./dist",
		"declaration": false,
		"removeComments": false,
		"sourceMap": true,
		"incremental": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"strict": true,
		"skipLibCheck": true,
		"strictPropertyInitialization": false,
		"forceConsistentCasingInFileNames": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"verbatimModuleSyntax": false,
		"tsBuildInfoFile": "./dist/.tsbuildinfo"
	},
	// The config files at the package root are covered too, so the editor gives
	// them Node's types — `drizzle.config.ts` reads `process.env`, and outside a
	// project tsc checks it with no types at all and reports `process` as
	// undefined. `rootDir` lives in tsconfig.build.json rather than here,
	// because it would reject these files for sitting outside `src`.
	"include": ["src", "drizzle.config.ts", "vitest.config.ts"],
	"exclude": ["node_modules", "dist"]
}
