{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"lib": ["esnext", "dom", "dom.iterable"],
		"types": ["vite/client"],
		"resolveJsonModule": true,
		"paths": {
			"@/*": ["./src/*"],
			"@assets/*": ["../backend/assets/*"]
		},
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src"]
}
